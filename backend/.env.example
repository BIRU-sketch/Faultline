# Faultline Backend Configuration

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-in-production-use-a-strong-secret-key
PORT=5000
HOST=127.0.0.1

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///faultline.db

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Execution Limits
MAX_TESTS_LIMIT=20
MAX_DURATION_SECONDS_LIMIT=120
MAX_RETRIES_LIMIT=3

# Optional LLM Provider Configuration for Evaluator Judge
# Supported providers: none, openai, anthropic (none by default)
LLM_JUDGE_PROVIDER=none
LLM_JUDGE_MODEL=gpt-4o-mini
LLM_JUDGE_API_KEY=

# OpenAI orchestration and controlled computer-use target.
OPENAI_API_KEY=
OPENAI_ORCHESTRATOR_MODEL=gpt-4o-mini
OPENAI_AGENT_MODEL=gpt-6-astra
FAULTLINE_DEMO_LEAK_SYSTEM_PROMPT=1
OPENAI_MAX_ORCHESTRATOR_STEPS=4
OPENAI_MAX_TESTS=10
OPENAI_MAX_REQUESTS=8
OPENAI_REQUEST_TIMEOUT_SECONDS=30
